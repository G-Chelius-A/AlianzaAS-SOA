{
	"info": {
		"_postman_id": "alianza-alas-del-sur-collection",
		"name": "Alianza Alas del Sur - API de Reservas",
		"description": "Colección completa de pruebas para el servicio canónico de reservas de la alianza Alas del Sur",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Muestras Oficiales (Creación)",
			"item": [
				{
					"name": "1.1 Crear Reserva AeroNorte (XML)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"idReservaAeroNorte\", jsonData.idReserva);",
									"pm.environment.set(\"idPasajeroAdulto\", jsonData.pasajero.idPasajero);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"xml\": \"<reserva>\\n  <pnr>QX7Z2A</pnr>\\n  <pasajero>GARCIA/ANA</pasajero>\\n  <fecha>03/04/2026</fecha>\\n  <tarifa>4500</tarifa>\\n  <equipaje>23</equipaje>\\n  <menor>N</menor>\\n</reserva>\"\n}"
						},
						"url": {
							"raw": "http://localhost:6767/api/v1/reservas/aeronorte",
							"protocol": "http",
							"host": ["localhost"],
							"port": "6767",
							"path": ["api", "v1", "reservas", "aeronorte"]
						}
					}
				},
